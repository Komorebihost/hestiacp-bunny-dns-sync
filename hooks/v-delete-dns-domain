#!/bin/bash
# =============================================================================
# HestiaCP hook: v-delete-dns-domain
# Fired by HestiaCP after a DNS zone is deleted.
# Complements the inotifywait DELETE event as a reliable fallback.
#
# Args: USER DOMAIN [RESTART]
# =============================================================================
USER="$1"
DOMAIN="$2"

[ -z "$USER" ] || [ -z "$DOMAIN" ] && exit 0

PLUGIN=/usr/local/hestia/plugins/bunny-dns/bunny-dns.sh
[ -x "$PLUGIN" ] || exit 0

"$PLUGIN" delete "$DOMAIN" "$USER"

exit 0
