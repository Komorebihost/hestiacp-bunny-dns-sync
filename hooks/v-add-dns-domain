#!/bin/bash
# =============================================================================
# HestiaCP hook: v-add-dns-domain
# Fired by HestiaCP after a new DNS zone is created.
# Fixes the inotifywait race condition that causes new domains to be missed.
#
# Args: USER DOMAIN [IP] [NS1] [NS2] [SOA] [EXPIRE] [TTL] [RESTART]
# =============================================================================
USER="$1"
DOMAIN="$2"

[ -z "$USER" ] || [ -z "$DOMAIN" ] && exit 0

PLUGIN=/usr/local/hestia/plugins/bunny-dns/bunny-dns.sh
[ -x "$PLUGIN" ] || exit 0

# Wait for HestiaCP to finish all writes before syncing
sleep 2
"$PLUGIN" sync "$DOMAIN" "$USER"

exit 0
