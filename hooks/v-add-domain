#!/bin/bash
# =============================================================================
# HestiaCP hook: v-add-domain
# Fired by HestiaCP after a full domain (web+mail+dns) is added.
# Handles the case where DNS is enabled as part of v-add-domain.
#
# Args: USER DOMAIN [IP] [ALIASES] [PROXY_EXT] [HSTS] [FORCE] [DNS] [MAIL] ...
# =============================================================================
USER="$1"
DOMAIN="$2"
DNS_FLAG="${8:-}"

[ -z "$USER" ] || [ -z "$DOMAIN" ] && exit 0

# Skip if DNS was explicitly disabled for this domain
[ "$DNS_FLAG" = "no" ] && exit 0

PLUGIN=/usr/local/hestia/plugins/bunny-dns/bunny-dns.sh
[ -x "$PLUGIN" ] || exit 0

# v-add-domain may call v-add-dns-domain internally (which triggers its own
# hook). We still run here as a safety net for custom HestiaCP builds that
# skip the DNS sub-command.
sleep 3
"$PLUGIN" sync "$DOMAIN" "$USER"

exit 0
